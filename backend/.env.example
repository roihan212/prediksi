# ─── Application ──────────────────────────────────────────────
APP_NAME=StockPredict API
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockpredict
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/stockpredict

# ─── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── ML ───────────────────────────────────────────────────────
MODELS_DIR=saved_models
DEFAULT_THRESHOLD=0.0        # Y=1 jika close[t+1] > close[t] * (1 + threshold)
TRAIN_TEST_RATIO=0.8

# ─── Stock Data ───────────────────────────────────────────────
TICKERS=BBCA.JK,BBRI.JK,BBNI.JK,BMRI.JK,BRIS.JK
DATA_FETCH_PERIOD=10y        # Ambil 10 tahun historis
FETCH_TIME_WIB=16:45         # Waktu fetch harian (16:45 WIB)

# ─── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
